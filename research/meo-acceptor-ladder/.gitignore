# Psi4 scratch: large, binary, machine-local, regenerable.
scratch/

# Psi4 output logs: regenerable, tens of MB at def2-TZVP, and they embed
# absolute scratch paths from the machine that produced them. The canonical
# evidence is results/ -- the per-state JSON records energies, oscillator
# strengths, orbital character, convergence actually used, and the environment.
logs/

# Optimized geometries and build diagnostics are regenerable; the canonical
# record is results/geometry_*.json.
geometry/*-def2-svp-opt.xyz
geometry/*-restart.xyz
geometry/*-derived-indices.json

# Psi4 drops these into the working directory on every run.
timer.dat
psi.*.clean
__pycache__/
