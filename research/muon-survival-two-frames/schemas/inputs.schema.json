{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvjohnston.com/research/muon-survival-two-frames/schemas/inputs.schema.json",
  "title": "Frozen production inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment", "post_type", "lineage", "production", "checks", "analysis", "restart"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment": {"const": "muon-survival-two-frames"},
    "post_type": {"const": "understanding"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "constants", "sources", "environment", "requirements", "workflow_graph", "workflow_cli"],
      "properties": {
        "protocol": {"$ref": "#/$defs/link"},
        "constants": {"$ref": "#/$defs/link"},
        "sources": {"$ref": "#/$defs/link"},
        "environment": {"$ref": "#/$defs/link"},
        "requirements": {"$ref": "#/$defs/link"},
        "workflow_graph": {"$ref": "#/$defs/link"},
        "workflow_cli": {"$ref": "#/$defs/link"}
      }
    },
    "production": {
      "type": "object",
      "required": ["normal_run_id", "canonical_command", "momentum_mev_c", "laboratory_grid", "focal_index", "rng", "raw_output"],
      "properties": {
        "normal_run_id": {"const": "run-001"},
        "canonical_command": {"const": "research/muon-survival-two-frames/.venv/bin/python research/muon-survival-two-frames/src/run.py --run-id run-001"},
        "momentum_mev_c": {"const": 3000.0},
        "laboratory_grid": {
          "type": "object",
          "properties": {
            "index_start": {"const": 0},
            "index_stop_inclusive": {"const": 200},
            "step_m": {"const": 100}
          },
          "required": ["index_start", "index_stop_inclusive", "step_m"]
        },
        "focal_index": {"const": 150},
        "rng": {
          "type": "object",
          "properties": {
            "library": {"const": "numpy"},
            "bit_generator": {"const": "PCG64"},
            "seed": {"const": 20260808},
            "draw_count": {"const": 100000},
            "dtype": {"const": "float64"}
          },
          "required": ["library", "bit_generator", "seed", "draw_count", "dtype"]
        },
        "raw_output": {"type": "object", "required": ["path_template", "shape", "dtype", "unit"]}
      }
    },
    "checks": {"type": "object"},
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_result_path", "canonical_result_command", "canonical_result_check_command", "admitted_run_selection", "result_commands_by_admitted_run", "figure_path", "figure_command", "figure_check_command", "metrics_path", "metrics_command", "metrics_check_command"],
      "properties": {
        "canonical_result_path": {"type": "string", "minLength": 1},
        "canonical_result_command": {"type": "string", "minLength": 1},
        "canonical_result_check_command": {"type": "string", "minLength": 1},
        "admitted_run_selection": {"type": "string", "minLength": 1},
        "result_commands_by_admitted_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run-001", "run-002"],
          "properties": {
            "run-001": {"$ref": "#/$defs/analysisCommands"},
            "run-002": {"$ref": "#/$defs/analysisCommands"}
          }
        },
        "figure_path": {"type": "string", "minLength": 1},
        "figure_command": {"type": "string", "minLength": 1},
        "figure_check_command": {"type": "string", "minLength": 1},
        "metrics_path": {"type": "string", "minLength": 1},
        "metrics_command": {"type": "string", "minLength": 1},
        "metrics_check_command": {"type": "string", "minLength": 1}
      }
    },
    "restart": {"type": "object"}
  },
  "$defs": {
    "analysisCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write", "check"],
      "properties": {
        "write": {"type": "string", "minLength": 1},
        "check": {"type": "string", "minLength": 1}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
