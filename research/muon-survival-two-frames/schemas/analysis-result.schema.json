{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvjohnston.com/research/muon-survival-two-frames/schemas/analysis-result.schema.json",
  "title": "Canonical two-frame Understanding result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment", "post_type", "outcome_kind", "generated_at", "analysis_admission", "provenance", "source_run", "primitive_inputs", "grid_m", "detector_frame", "muon_frame", "same_speed_no_lifetime_dilation_counterfactual", "empirical", "focal", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment": {"const": "muon-survival-two-frames"},
    "post_type": {"const": "understanding"},
    "outcome_kind": {"const": "understanding-observations-no-verdict"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_admission": {"type": "object", "required": ["event_id", "sequence", "decision", "event_sha256"]},
    "provenance": {"type": "object", "required": ["generator", "generator_sha256", "inputs"]},
    "source_run": {"type": "object", "required": ["run_id", "manifest", "sample", "completion"]},
    "primitive_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["momentum_mev_c", "mass_energy_mev", "tau0_s", "c_m_s", "units"],
      "properties": {
        "momentum_mev_c": {"type": "number", "exclusiveMinimum": 0},
        "mass_energy_mev": {"type": "number", "exclusiveMinimum": 0},
        "tau0_s": {"type": "number", "exclusiveMinimum": 0},
        "c_m_s": {"type": "number", "exclusiveMinimum": 0},
        "units": {"type": "object", "required": ["momentum_mev_c", "mass_energy_mev", "tau0_s", "c_m_s", "paths_m"]}
      }
    },
    "grid_m": {"$ref": "#/$defs/numberArray"},
    "detector_frame": {"$ref": "#/$defs/detectorFrame"},
    "muon_frame": {"$ref": "#/$defs/muonFrame"},
    "same_speed_no_lifetime_dilation_counterfactual": {"$ref": "#/$defs/counterfactual"},
    "empirical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "survival_probability", "inclusive_comparison"],
      "properties": {
        "counts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "survival_probability": {"$ref": "#/$defs/probabilityArray"},
        "inclusive_comparison": {"const": "proper_lifetime_s >= proper_elapsed_time_s"}
      }
    },
    "focal": {"type": "object", "required": ["index", "detector", "muon", "counterfactual", "empirical_count", "empirical_survival_probability"]},
    "checks": {
      "type": "object",
      "required": ["frame_agreement", "focal_monte_carlo_within_four_standard_errors", "maximum_grid_discrepancy_at_most_threshold", "counts_valid_and_monotonic", "numeric_shapes_dtypes_units_valid", "schema_manifest_provenance_and_hashes_valid", "all_passed", "details", "diagnostics"]
    }
  },
  "$defs": {
    "numberArray": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "probabilityArray": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "detectorFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beta", "gamma", "laboratory_distance_m", "elapsed_time_s", "mean_lifetime_s", "decay_exponent", "survival_probability", "units"],
      "properties": {
        "beta": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "gamma": {"type": "number", "minimum": 1},
        "laboratory_distance_m": {"$ref": "#/$defs/numberArray"},
        "elapsed_time_s": {"$ref": "#/$defs/numberArray"},
        "mean_lifetime_s": {"type": "number", "exclusiveMinimum": 0},
        "decay_exponent": {"$ref": "#/$defs/numberArray"},
        "survival_probability": {"$ref": "#/$defs/probabilityArray"},
        "units": {"type": "object"}
      }
    },
    "muonFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beta", "gamma", "contracted_distance_m", "elapsed_time_s", "mean_lifetime_s", "decay_exponent", "survival_probability", "units"],
      "properties": {
        "beta": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "gamma": {"type": "number", "minimum": 1},
        "contracted_distance_m": {"$ref": "#/$defs/numberArray"},
        "elapsed_time_s": {"$ref": "#/$defs/numberArray"},
        "mean_lifetime_s": {"type": "number", "exclusiveMinimum": 0},
        "decay_exponent": {"$ref": "#/$defs/numberArray"},
        "survival_probability": {"$ref": "#/$defs/probabilityArray"},
        "units": {"type": "object"}
      }
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "laboratory_distance_m", "elapsed_time_s", "decay_exponent", "survival_probability", "units"],
      "properties": {
        "label": {"const": "same-speed, no-lifetime-dilation counterfactual"},
        "laboratory_distance_m": {"$ref": "#/$defs/numberArray"},
        "elapsed_time_s": {"$ref": "#/$defs/numberArray"},
        "decay_exponent": {"$ref": "#/$defs/numberArray"},
        "survival_probability": {"$ref": "#/$defs/probabilityArray"},
        "units": {"type": "object"}
      }
    }
  }
}
